# ResistScope frontend (Vite) environment.
# Copy to `frontend/.env` to override defaults. Both are dev-server only.

# Where the Vite dev server proxies /api/* requests. Point this at the
# FastAPI backend (uvicorn). Defaults to http://localhost:8000 if unset.
VITE_API_TARGET=http://localhost:8000

# Optional: port the Vite dev server listens on. Defaults to 5173.
# VITE_DEV_PORT=5173
