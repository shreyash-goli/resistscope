# ResistScope backend environment.
# Copy to `.env` and fill in. `.env` is gitignored; this example is committed.

# Anthropic API key — used for Claude mechanistic explanations and the
# faithfulness judge (services/explanation.py, scripts/06 & 07).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Live docking backend (optional) -----------------------------------------
# How the API docks a custom SMILES (benchmark drugs are always precomputed).
# If unset AND the local docking stack (meeko/RDKit/Vina) is not installed, the
# API returns a clean 503 telling the user how to enable one.
#
# Connect a GPU: run `python docking_worker.py` on a GPU box (see
# deploy/setup_a100.sh) and point the API at it:
# RESISTSCOPE_DOCKING_URL=http://<gpu-host>:9000
#
# Local docking engine when no URL is set and the stack IS installed:
# RESISTSCOPE_DOCKING_ENGINE=vina   # or "unidock" if a local GPU is present
